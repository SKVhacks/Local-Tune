<Application
    x:Class="LocalTune.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LocalTune.Views">
    <!-- No RequestedTheme: the app follows Windows' light or dark mode, and changes with it. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <views:Templates />
            </ResourceDictionary.MergedDictionaries>

            <!-- The accent: the one colour besides the artwork's, as on the phone. -->
            <Color x:Key="SystemAccentColor">#FA2D48</Color>
            <Color x:Key="SystemAccentColorLight1">#FB4A61</Color>
            <Color x:Key="SystemAccentColorLight2">#FC6779</Color>
            <Color x:Key="SystemAccentColorLight3">#FD8593</Color>
            <Color x:Key="SystemAccentColorDark1">#E0283F</Color>
            <Color x:Key="SystemAccentColorDark2">#C42337</Color>
            <Color x:Key="SystemAccentColorDark3">#A81E2F</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#FA2D48" />

            <!-- A round, see-through button for icons. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- A see-through button around a cover and its words. -->
            <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
