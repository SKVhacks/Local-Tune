<Window
    x:Class="LocalTune.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LocalTune.Views"
    Title="LocalTune">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar: the window is dragged by it; Windows draws the caption buttons. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Logo.png" Width="18" Height="18" />
                <TextBlock Text="LocalTune" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="Nav"
                PaneDisplayMode="Left"
                IsPaneToggleButtonVisible="True"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                IsTitleBarAutoPaddingEnabled="False"
                OpenPaneLength="240"
                ItemInvoked="OnNavInvoked"
                BackRequested="OnBackRequested">
                <NavigationView.Resources>
                    <!-- No bar beside the open item: a soft rounded highlight, as Apple's sidebar has. -->
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">36</x:Double>
                </NavigationView.Resources>
                <NavigationView.AutoSuggestBox>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search" QueryIcon="Find" TextChanged="OnSearchChanged" />
                </NavigationView.AutoSuggestBox>
                <!-- Laid out as Apple Music's sidebar: Home, then Library, then Playlists (filled in from code). -->
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" Foreground="{StaticResource AccentBrush}" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader Content="Library" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <NavigationViewItem Content="Songs" Tag="songs">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource AccentBrush}" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Albums" Tag="albums">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" Foreground="{StaticResource AccentBrush}" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Artists" Tag="artists">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" Foreground="{StaticResource AccentBrush}" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Folders" Tag="folders">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="{StaticResource AccentBrush}" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemHeader x:Name="PlaylistsHeader" Content="Playlists" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </NavigationView.MenuItems>
                <NavigationView.PaneFooter>
                    <TextBlock x:Name="ScanText" Text="Reading your music…" Margin="16,0,16,8" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </NavigationView.PaneFooter>
                <Grid>
                    <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="False" />
                    <!-- Back: at the top left of the page, only when there's somewhere to go back to. -->
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="34" Height="34" Margin="16,6,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Click="OnBackClick"
                            ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>
                </Grid>
            </NavigationView>

            <views:QueuePanel x:Name="QueuePane" Grid.Column="1" Visibility="Collapsed" />
        </Grid>

        <views:PlayerBar x:Name="Bar" Grid.Row="2" />

        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" />

        <views:NowPlayingView x:Name="NowPlaying" Grid.RowSpan="3" Visibility="Collapsed" />
    </Grid>
</Window>
